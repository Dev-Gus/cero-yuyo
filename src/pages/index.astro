---
import { Image } from 'astro:assets';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import LogoMark from '../components/LogoMark.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
import '../styles/global.css';

const jobs = site.jobs.filter((job) => job.before?.src && job.after?.src);
const hasJobs = jobs.length > 0;
---

<!doctype html>
<html lang="es">
  <head>
    <PageHead title={site.title} description={site.description} isHome />
  </head>
  <body>
    <a class="skip-link button" href="#contenido">{site.skipLink}</a>
    <header class="site-header container">
      <span class="wordmark"><LogoMark />{site.name}</span>
      <WhatsAppLink label={site.headerButton} />
    </header>

    <main id="contenido" tabindex="-1">
      <div class="container">
        <section class:list={['hero', { 'hero-with-photo': site.heroImage }]} aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">{site.hero.eyebrow}</p>
            <h1 id="hero-title">{site.hero.heading}</h1>
            <p class="hero-description">{site.hero.text}</p>
            <WhatsAppLink label={site.photoButton} />
          </div>
          {site.heroImage && (
            <Image
              class="hero-image"
              src={site.heroImage.src}
              alt={site.heroImage.alt}
              widths={[320, 480, 640, 960, 1254]}
              sizes="(min-width: 1280px) 464px, (min-width: 1024px) 40vw, (min-width: 480px) 81vw, calc(100vw - 5rem)"
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )}
        </section>

        <section id="que-hago" class="section services" aria-labelledby="services-title">
          <h2 id="services-title">{site.services.heading}</h2>
          <ul class="service-list">
            {site.services.items.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="como-trabajo" class="section process" aria-labelledby="process-title">
          <h2 id="process-title">{site.process.heading}</h2>
          <ol class="step-list">
            {site.process.steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </section>

        {hasJobs && (
          <section id="trabajos" class="section jobs" aria-labelledby="jobs-title">
            <h2 id="jobs-title">{site.jobsHeading}</h2>
            <p class="jobs-intro">{site.jobsIntro}</p>
            <div class="job-list">
              {jobs.map((job) => (
                <div class="job">
                  <div class="job-pair">
                    <figure>
                      <Image
                        src={job.before.src}
                        alt={job.before.alt}
                        widths={[360, 540, 720, 1080, 1200].filter((width) => width <= job.before.src.width)}
                        sizes="(min-width: 1218px) 544px, (min-width: 768px) calc(46vw - 1rem), (min-width: 400px) 92vw, calc(100vw - 2rem)"
                        format="webp"
                        quality={80}
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption class="job-label">Antes</figcaption>
                    </figure>
                    <figure>
                      <Image
                        src={job.after.src}
                        alt={job.after.alt}
                        widths={[360, 540, 720, 1080, 1200].filter((width) => width <= job.after.src.width)}
                        sizes="(min-width: 1218px) 544px, (min-width: 768px) calc(46vw - 1rem), (min-width: 400px) 92vw, calc(100vw - 2rem)"
                        format="webp"
                        quality={80}
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption class="job-label">Después</figcaption>
                    </figure>
                  </div>
                  {job.description && <p class="job-description">{job.description}</p>}
                </div>
              ))}
            </div>
          </section>
        )}

        <section id="quien-soy" class="section about" aria-labelledby="about-title">
          <h2 id="about-title">{site.about.heading}</h2>
          <p>{site.about.text}</p>
        </section>

        <section class="contact" aria-labelledby="contact-title">
          <div class="contact-copy">
            <h2 id="contact-title">{site.contact.heading}</h2>
          </div>
          <div class="contact-action">
            <WhatsAppLink label={site.photoButton} />
            <WhatsAppLink label={site.contact.phone} variant="number" />
          </div>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <div class="footer-brand">
            <span class="wordmark"><LogoMark />{site.name}</span>
            <p>{site.footer.location}</p>
          </div>
          <div class="footer-contact">
            <nav class="footer-nav">
              <a href="#que-hago">{site.services.heading}</a>
              <a href="#como-trabajo">{site.process.heading}</a>
              {hasJobs && <a href="#trabajos">Trabajos</a>}
              <a href="#quien-soy">{site.about.heading}</a>
            </nav>
            <WhatsAppLink label={site.contact.phone} variant="number" />
          </div>
        </div>
        <div class="footer-bottom"><p>{site.footer.copyright}</p><small>{site.footer.credit}</small></div>
      </div>
    </footer>
  </body>
</html>

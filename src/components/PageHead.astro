---
import { INDEXABLE, SITE_URL, site, socialImage } from '../data/site';

interface Props { title: string; description?: string; isHome?: boolean }
const { title, description, isHome = false } = Astro.props;
const canonicalURL = new URL('/', SITE_URL).href;
const imageURL = new URL(socialImage.path, SITE_URL).href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: canonicalURL,
  description: site.description,
  telephone: `+${site.whatsapp.number}`,
  image: imageURL,
  areaServed: {
    '@type': 'City',
    name: 'Tacuarembó',
    containedInPlace: { '@type': 'Country', name: 'UY' },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    itemListElement: site.services.items.map(({ title: name }) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name },
    })),
  },
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={INDEXABLE && isHome ? 'index, follow' : 'noindex'} />
<!-- Matches --color-primary in src/styles/global.css. -->
<meta name="theme-color" content="#1f5a2e" />
{isHome && (
  <>
    <link rel="canonical" href={canonicalURL} />
    {INDEXABLE && <link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', SITE_URL).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <script type="application/ld+json" set:html={JSON.stringify(business).replaceAll('<', '\\u003c')} />
  </>
)}

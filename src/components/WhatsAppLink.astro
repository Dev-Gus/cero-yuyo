---
import { whatsappUrl } from '../lib/whatsapp';
import ChatIcon from './ChatIcon.astro';

interface Props {
  label: string;
  variant?: 'button' | 'number';
}

const { label, variant = 'button' } = Astro.props;
---

<a class={variant === 'number' ? 'phone-link' : 'button'} href={whatsappUrl()}><ChatIcon /><span>{label}</span></a>
